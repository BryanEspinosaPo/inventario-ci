
pipeline {
    agent any

    stages {
        stage('Pruebas unitarias') {
            steps {
                dir('app') {
                    sh '''
                        python3 -m venv .venv
                        .venv/bin/python -m pip install --upgrade pip
                        .venv/bin/pip install pytest fastapi uvicorn httpx
                        .venv/bin/python -m pytest tests/ -v
                    '''
                }
            }
        }

        stage('Construir imagen') {
            steps {
                sh 'docker build -t inventario:1.0.0 ./app'
            }
        }

        stage('Prueba de humo') {
            steps {
                sh '''
                    docker rm -f inventario-test || true
                    docker run -d --name inventario-test -p 8000:8000 inventario:1.0.0

                    sleep 5

                    docker exec inventario-test python -c "import urllib.request; r=urllib.request.urlopen('http://localhost:8000/'); print(r.read().decode())"

                    docker rm -f inventario-test
                '''
            }
        }
    }

    post {
        success {
            echo 'Pipeline de Inventario finalizado correctamente.'
        }
        failure {
            echo 'El pipeline presentó un error. Revisar Console Output.'
        }
    }
}
